{
  "version": 1,
  "include": ["/*"],
  "exclude": ["/api/*", "/assets/*", "/static/*"],
  "routes": [
    {
      "src": "^/api/.*",
      "dest": "https://api.your-domain.com/api/$1"
    },
    {
      "src": "^/static/.*",
      "dest": "/static/$1"
    },
    {
      "src": "^/assets/.*",
      "dest": "/assets/$1"
    },
    {
      "src": "^/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))$",
      "dest": "/$1"
    },
    {
      "src": "^/(.*)",
      "dest": "/index.html"
    }
  ]
}
