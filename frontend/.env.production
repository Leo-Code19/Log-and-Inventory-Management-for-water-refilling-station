VITE_API_URL=https://api.your-domain.com
VITE_SOCKET_URL=wss://api.your-domain.com
VITE_ENV=production
VITE_CLOUDFLARE_ENABLED=true
VITE_CLOUDFLARE_ANALYTICS_TOKEN=your-analytics-token-here

# Cloudflare Pages specific settings
VITE_CLOUDFLARE_PAGES=true
VITE_CLOUDFLARE_WORKERS=true

# Security settings
VITE_SECURE_COOKIES=true
VITE_HSTS_ENABLED=true

# Performance settings
VITE_ENABLE_COMPRESSION=true
VITE_ENABLE_PRELOADING=true
